# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# Хранилище. Для локального запуска достаточно SQLite-файла (по умолчанию seadelivery.db).
# Для продакшена укажите Postgres URI, например Neon:
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Необязательно: путь к SQLite-файлу (используется, если DATABASE_URL пуст).
# DB_PATH=seadelivery.db

# Необязательно: Telegram user ID супер-владельца — получает права админа во всех чатах.
# OWNER_ID=123456789

# Необязательно: список chat_id через запятую/пробел. Пусто = работать в любом чате.
# ALLOWED_CHAT_IDS=-1001234567890

# --- только для webhook-режима (uvicorn seadelivery_bot.webhook_app:app) ---
# WEBHOOK_URL=https://your-app.example.com
# WEBHOOK_SECRET=
